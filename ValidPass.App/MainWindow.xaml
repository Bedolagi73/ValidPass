<Window x:Class="ValidPass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор и валидатор паролей" Width="1120" Height="740" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Margin="12,12,12,0" Background="Transparent" BorderThickness="0">

            <!-- ================= Генерация ================= -->
            <TabItem Header="Генерация">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Value, ElementName=LengthSlider, StringFormat={}{0:0}}" />
                                    <TextBlock Text="Длина пароля" />
                                </DockPanel>
                                <Slider x:Name="LengthSlider" Minimum="4" Maximum="128" Value="16" IsSnapToTickEnabled="True"
                                        TickFrequency="1" Margin="0,6,0,0" ValueChanged="GenerationOption_Changed" />

                                <TextBlock Text="Количество (1–1000)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CountBox" Text="10" TextChanged="GenerationOption_Changed" />

                                <TextBlock Text="НАБОРЫ СИМВОЛОВ" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="LowerCheck" Content="Строчные a–z" IsChecked="True" Checked="GenerationOption_Changed" Unchecked="GenerationOption_Changed" />
                                    <CheckBox x:Name="UpperCheck" Grid.Row="1" Content="Заглавные A–Z" IsChecked="True" Checked="GenerationOption_Changed" Unchecked="GenerationOption_Changed" />
                                    <CheckBox x:Name="DigitsCheck" Grid.Row="2" Content="Цифры 0–9" IsChecked="True" Checked="GenerationOption_Changed" Unchecked="GenerationOption_Changed" />
                                    <CheckBox x:Name="SpecialCheck" Grid.Row="3" Content="Спецсимволы" IsChecked="True" Checked="GenerationOption_Changed" Unchecked="GenerationOption_Changed" />
                                    <TextBlock Grid.Column="1" Grid.RowSpan="4" Text="мин." Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox x:Name="MinLowerBox" Grid.Column="2" Text="0" Margin="0,4,0,0" TextChanged="GenerationOption_Changed" />
                                    <TextBox x:Name="MinUpperBox" Grid.Column="2" Grid.Row="1" Text="0" Margin="0,4,0,0" TextChanged="GenerationOption_Changed" />
                                    <TextBox x:Name="MinDigitsBox" Grid.Column="2" Grid.Row="2" Text="0" Margin="0,4,0,0" TextChanged="GenerationOption_Changed" />
                                    <TextBox x:Name="MinSpecialBox" Grid.Column="2" Grid.Row="3" Text="0" Margin="0,4,0,0" TextChanged="GenerationOption_Changed" />
                                </Grid>

                                <TextBlock Text="Набор спецсимволов" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SpecialCharsBox" FontFamily="{StaticResource MonoFont}" TextChanged="GenerationOption_Changed" />

                                <CheckBox x:Name="AmbiguousCheck" Content="Без неоднозначных (0 O o 1 l I |)" Margin="0,10,0,0"
                                          Checked="GenerationOption_Changed" Unchecked="GenerationOption_Changed" />

                                <Button Content="Сгенерировать" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Padding="12,9"
                                        Click="GenerateButton_Click" IsDefault="True" />
                                <TextBlock x:Name="GenerationInfo" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="PasswordsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                                      HorizontalGridLinesBrush="#EEF1F4" RowHeight="30" Background="White"
                                      CanUserResizeRows="False" SelectionMode="Extended"
                                      MouseDoubleClick="PasswordsGrid_MouseDoubleClick">
                                <DataGrid.Resources>
                                    <Style x:Key="CellText" TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="4,0" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="48" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="*" FontFamily="Consolas" FontSize="14" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="64" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Энтропия, бит" Binding="{Binding EntropyBits, StringFormat={}{0:0.0}}" Width="110" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTemplateColumn Header="Стойкость" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StrengthText}" Foreground="{Binding StrengthBrush}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="EmptyGridHint" Text="Нажмите «Сгенерировать». Двойной клик по паролю — скопировать."
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />

                            <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                                <Button Content="Копировать" Click="CopySelectedButton_Click" Margin="0,0,8,0" />
                                <Button Content="Копировать все" Click="CopyAllButton_Click" Margin="0,0,24,0" />
                                <TextBlock Text="Разделитель" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="GenDelimiterCombo" Width="140" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,12,0">
                                    <ComboBoxItem Content=", (запятая)" />
                                    <ComboBoxItem Content="; (для Excel)" />
                                </ComboBox>
                                <CheckBox x:Name="GenMaskCheck" Content="Маскировать" Margin="0,0,12,0" />
                                <Button Content="Экспорт в CSV" Click="ExportGeneratedButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= Валидация ================= -->
            <TabItem Header="Валидация">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Пароль для проверки" Margin="0,0,0,6" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordInput" FontFamily="{StaticResource MonoFont}" FontSize="15" Height="36"
                                             PasswordChanged="PasswordInput_PasswordChanged" KeyDown="PasswordInput_KeyDown" />
                                <TextBox x:Name="PasswordPlain" FontFamily="{StaticResource MonoFont}" FontSize="15" Height="36"
                                         Visibility="Collapsed" TextChanged="PasswordPlain_TextChanged" KeyDown="PasswordInput_KeyDown" />
                                <CheckBox x:Name="ShowPasswordCheck" Grid.Column="1" Content="Показать" Margin="12,0,12,0"
                                          Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed" />
                                <Button Grid.Column="2" Content="Проверить" Style="{StaticResource AccentButton}" Padding="18,8"
                                        Click="ValidateButton_Click" />
                            </Grid>

                            <!-- Итог: вердикт, шкала, энтропия -->
                            <Grid Grid.Row="2" Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock x:Name="EntropyText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="VerdictText" FontSize="20" FontWeight="SemiBold" Text="Введите пароль" />
                                </DockPanel>
                                <Border Grid.Row="1" Height="10" CornerRadius="5" Background="#E5E9EE" Margin="0,10,0,0">
                                    <Border x:Name="StrengthBar" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#DC2626" />
                                </Border>
                                <UniformGrid Grid.Row="2" Columns="4" Margin="0,4,0,0">
                                    <TextBlock Text="слабый" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="средний" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="сильный" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="очень сильный" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </UniformGrid>
                            </Grid>

                            <!-- Правила -->
                            <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="RulesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="15" FontWeight="Bold" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <WrapPanel Grid.Row="4" Margin="0,12,0,0">
                                <TextBlock x:Name="CheckedCountText" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{StaticResource MutedBrush}" Text="Проверено: 0" />
                                <ComboBox x:Name="ValDelimiterCombo" Width="140" SelectedIndex="0" VerticalContentAlignment="Center" Margin="0,0,12,0">
                                    <ComboBoxItem Content=", (запятая)" />
                                    <ComboBoxItem Content="; (для Excel)" />
                                </ComboBox>
                                <CheckBox x:Name="ValMaskCheck" Content="Маскировать" IsChecked="True" Margin="0,0,12,0" />
                                <Button Content="Экспорт проверенных в CSV" Click="ExportCheckedButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Политика и списки -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="ТРЕБОВАНИЯ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Мин. длина" Margin="0,0,0,4" />
                                        <TextBox x:Name="MinLengthBox" Text="8" TextChanged="PolicyOption_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Макс. (0 — нет)" Margin="0,0,0,4" />
                                        <TextBox x:Name="MaxLengthBox" Text="128" TextChanged="PolicyOption_Changed" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ReqLowerCheck" Content="Строчные буквы" IsChecked="True" Checked="PolicyOption_Changed" Unchecked="PolicyOption_Changed" />
                                <CheckBox x:Name="ReqUpperCheck" Content="Заглавные буквы" IsChecked="True" Checked="PolicyOption_Changed" Unchecked="PolicyOption_Changed" />
                                <CheckBox x:Name="ReqDigitsCheck" Content="Цифры" IsChecked="True" Checked="PolicyOption_Changed" Unchecked="PolicyOption_Changed" />
                                <CheckBox x:Name="ReqSpecialCheck" Content="Спецсимволы" IsChecked="True" Checked="PolicyOption_Changed" Unchecked="PolicyOption_Changed" />

                                <TextBlock Text="ПОРОГИ ШКАЛЫ, БИТ" Style="{StaticResource SectionTitle}" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="средний" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="MediumBox" Text="40" TextChanged="PolicyOption_Changed" />
                                    </StackPanel>
                                    <StackPanel Margin="3,0">
                                        <TextBlock Text="сильный" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="StrongBox" Text="60" TextChanged="PolicyOption_Changed" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="оч. сильный" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <TextBox x:Name="VeryStrongBox" Text="80" TextChanged="PolicyOption_Changed" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="СЛОВАРИ" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="DictionaryInfo" TextWrapping="Wrap" />
                                <TextBlock x:Name="LeaksInfo" TextWrapping="Wrap" Margin="0,6,0,0" Text="Список утечек не загружен." />
                                <ProgressBar x:Name="LeaksProgress" Height="6" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="LoadLeaksButton" Content="Загрузить список утечек…" Click="LoadLeaksButton_Click" />
                                    <Button x:Name="CancelLeaksButton" Grid.Column="2" Content="Отмена" IsEnabled="False" Click="CancelLeaksButton_Click" />
                                </Grid>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                           Text="TXT: по строке на пароль или SHA-1 (формат HIBP «HASH:count» тоже подходит)." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Статусная строка -->
        <Border Grid.Row="1" Background="#E9EDF1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Готово." />
        </Border>
    </Grid>
</Window>
